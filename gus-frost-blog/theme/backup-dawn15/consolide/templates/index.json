      "blocks": {
        "collapsible_row_TbrFhU": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Vos produits conviennent-ils à tous les chiens et chats ?",
            "icon": "question_mark",
            "row_content": "<p>Oui. Nos produits sont sélectionnés pour couvrir la majorité des morphologies et tempéraments. Chaque fiche produit précise les tailles, usages et recommandations.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_XN4aVA": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Livrez-vous en France et en Europe ?",
            "icon": "question_mark",
            "row_content": "<p>Oui. Nous livrons en France et dans la plupart des pays européens avec un suivi de commande à chaque étape.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_LBmtAb": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Combien de temps faut-il pour recevoir ma commande ?",
            "icon": "question_mark",
            "row_content": "<p>En moyenne, la livraison prend entre <strong>5 et 10 jours ouvrés<\/strong>, selon le produit et votre lieu de résidence.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_TymYrP": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Puis-je retourner un article s’il ne convient pas ?",
            "icon": "question_mark",
            "row_content": "<p>Bien sûr. Vous disposez de <strong>14 jours<\/strong> après réception pour nous contacter. Notre service client vous accompagne simplement.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_F8kh49": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Pourquoi faire confiance à Gus & Frost ?",
            "icon": "question_mark",
            "row_content": "<p>Nous sélectionnons uniquement des produits utiles, testés et validés pour le bien-être de votre animal. Pas de gadgets, pas de compromis sur la qualité.<\/p>",
            "page": ""
          }
        }
