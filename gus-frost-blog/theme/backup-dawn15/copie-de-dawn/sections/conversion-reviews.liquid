{%- comment -%}
  Section réutilisable : carrousel d'avis clients (codés en dur, pas d'app).
  ⚠️ N'affichez que de VRAIS avis. CSS scopé #crv-{{ section.id }}.
  Blocs : "review".
{%- endcomment -%}

{%- assign st = section.settings -%}

<div id="crv-{{ section.id }}" class="crv color-{{ st.color_scheme }} isolate">
  <div class="crv__wrap page-width">
    <div class="crv__head">
      <div>
        {%- if st.heading != blank -%}<h2 class="crv__heading">{{ st.heading }}</h2>{%- endif -%}
        {%- if st.summary != blank -%}
          <p class="crv__summary"><span class="crv__stars" aria-hidden="true">★★★★★</span> {{ st.summary }}</p>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="crv__nav">
          <button class="crv__arrow" data-dir="-1" aria-label="Précédent">‹</button>
          <button class="crv__arrow" data-dir="1" aria-label="Suivant">›</button>
        </div>
      {%- endif -%}
    </div>

    <div class="crv__track" data-crv-track>
      {%- for block in section.blocks -%}
        {%- assign r = block.settings -%}
        <article class="crv__card" {{ block.shopify_attributes }}>
          <div class="crv__card-top">
            <span class="crv__card-stars" aria-hidden="true">
              {%- assign n = r.rating | plus: 0 -%}
              {%- for i in (1..5) -%}{% if i <= n %}★{% else %}<span class="crv__star-off">★</span>{% endif %}{%- endfor -%}
            </span>
            {%- if r.verified -%}<span class="crv__badge">✓ Achat vérifié</span>{%- endif -%}
          </div>
          {%- if r.title != blank -%}<h3 class="crv__card-title">{{ r.title }}</h3>{%- endif -%}
          <p class="crv__card-text">{{ r.text }}</p>
          {%- if r.image -%}
            <img class="crv__card-img" src="{{ r.image | image_url: width: 320 }}" width="120" height="120" loading="lazy" alt="{{ r.name | escape }}">
          {%- endif -%}
          <div class="crv__card-author">
            {%- if r.avatar -%}<img class="crv__avatar" src="{{ r.avatar | image_url: width: 72 }}" width="36" height="36" loading="lazy" alt="">{%- endif -%}
            <span class="crv__name">{{ r.name }}</span>
            {%- if r.date != blank -%}<span class="crv__date">· {{ r.date }}</span>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #crv-{{ section.id }}.crv{padding:{{ st.padding_top }}px 0 {{ st.padding_bottom }}px}
  #crv-{{ section.id }} .crv__head{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;margin-bottom:1.4rem}
  #crv-{{ section.id }} .crv__heading{margin:0}
  #crv-{{ section.id }} .crv__summary{margin:.4rem 0 0;font-weight:600}
  #crv-{{ section.id }} .crv__stars,
  #crv-{{ section.id }} .crv__card-stars{color:{{ st.star_color }};letter-spacing:1px}
  #crv-{{ section.id }} .crv__star-off{color:{{ st.star_color }};opacity:.28}
  #crv-{{ section.id }} .crv__nav{display:flex;gap:.5rem;flex:0 0 auto}
  #crv-{{ section.id }} .crv__arrow{width:40px;height:40px;border-radius:50%;border:1px solid rgba(0,0,0,.15);
    background:transparent;font-size:1.4rem;line-height:1;cursor:pointer;color:inherit;transition:background .15s}
  #crv-{{ section.id }} .crv__arrow:hover{background:rgba(0,0,0,.06)}
  #crv-{{ section.id }} .crv__track{display:flex;gap:1rem;overflow-x:auto;scroll-snap-type:x mandatory;
    scroll-behavior:smooth;padding-bottom:.5rem;-ms-overflow-style:none;scrollbar-width:none}
  #crv-{{ section.id }} .crv__track::-webkit-scrollbar{display:none}
  #crv-{{ section.id }} .crv__card{scroll-snap-align:start;flex:0 0 {{ st.card_width }}px;max-width:85vw;
    border:1px solid rgba(0,0,0,.08);border-radius:14px;padding:1.2rem;background:rgba(0,0,0,.015);
    display:flex;flex-direction:column;gap:.55rem}
  #crv-{{ section.id }} .crv__card-top{display:flex;justify-content:space-between;align-items:center;gap:.5rem}
  #crv-{{ section.id }} .crv__badge{font-size:.72rem;font-weight:600;color:{{ st.accent }};white-space:nowrap}
  #crv-{{ section.id }} .crv__card-title{margin:0;font-size:1rem}
  #crv-{{ section.id }} .crv__card-text{margin:0;line-height:1.5;font-size:.94rem;opacity:.9}
  #crv-{{ section.id }} .crv__card-img{border-radius:10px;object-fit:cover;width:100%;max-height:200px;margin-top:.2rem}
  #crv-{{ section.id }} .crv__card-author{display:flex;align-items:center;gap:.5rem;margin-top:auto;padding-top:.4rem;font-size:.9rem}
  #crv-{{ section.id }} .crv__avatar{border-radius:50%;object-fit:cover}
  #crv-{{ section.id }} .crv__name{font-weight:700}
  #crv-{{ section.id }} .crv__date{opacity:.6}
  @media (max-width:749px){
    #crv-{{ section.id }} .crv__nav{display:none}
  }
</style>

<script>
  (function(){
    var root = document.getElementById('crv-{{ section.id }}');
    if(!root) return;
    var track = root.querySelector('[data-crv-track]');
    root.querySelectorAll('.crv__arrow').forEach(function(btn){
      btn.addEventListener('click', function(){
        var dir = parseInt(btn.getAttribute('data-dir'),10);
        var card = track.querySelector('.crv__card');
        var step = card ? (card.offsetWidth + 16) : 320;
        track.scrollBy({left: dir*step, behavior:'smooth'});
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Avis clients (carrousel)",
  "tag": "section",
  "class": "section-crv",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ils en parlent mieux que nous" },
    { "type": "text", "id": "summary", "label": "Résumé (ex: 4,8/5 sur 320 avis)", "info": "N'affichez que de vrais chiffres." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Jeu de couleurs", "default": "scheme-1" },
    { "type": "color", "id": "star_color", "label": "Étoiles", "default": "#f5a623" },
    { "type": "color", "id": "accent", "label": "Accent (badge vérifié)", "default": "#2e7d32" },
    { "type": "range", "id": "card_width", "min": 240, "max": 420, "step": 10, "unit": "px", "label": "Largeur carte", "default": 320 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haut", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge bas", "default": 48 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Note (étoiles)", "default": 5 },
        { "type": "text", "id": "title", "label": "Titre de l'avis" },
        { "type": "textarea", "id": "text", "label": "Avis", "default": "Un vrai bonheur au quotidien, mon chien adore !" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Client vérifié" },
        { "type": "text", "id": "date", "label": "Date (texte libre)" },
        { "type": "checkbox", "id": "verified", "label": "Achat vérifié", "default": true },
        { "type": "image_picker", "id": "avatar", "label": "Photo de profil (optionnel)" },
        { "type": "image_picker", "id": "image", "label": "Photo jointe (optionnel)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients (carrousel)",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
