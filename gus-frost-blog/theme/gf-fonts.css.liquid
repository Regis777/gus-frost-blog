/* gf-fonts.css — typographie Gus & Frost : Fraunces (titres) + Figtree (corps)
   Remplace Montserrat 600 / Lora 400 sans toucher au selecteur de polices du theme.

   A CHARGER APRES le bloc <style> de layout/theme.liquid (donc avant </head>),
   sur TOUTES les pages — pas seulement les articles : la boutique, le Carnet et
   le quiz doivent partager la meme typographie.

   Fichier depose en assets/gf-fonts.css.liquid : Shopify le rend puis le sert
   sous le nom gf-fonts.css. Le passage par Liquid permet d'ecrire asset_url
   dans les url(), donc des URL STRICTEMENT identiques a celles du <link
   rel=preload> de theme.liquid — sinon le navigateur telecharge deux fois.
   Aucun appel a fonts.gstatic.com : rien a declarer cote RGPD.

   Poids charge : 32 Ko (Fraunces latin) + 20 Ko (Figtree latin) sur une page
   sans italique ; ~81 Ko sur un article avec legendes de figure (italique).
   Les sous-ensembles latin-ext et l'italique ne se telechargent que si la page
   en a besoin (unicode-range / font-style).

   ORDRE DES @font-face : latin-ext AVANT latin, comme le fait Google. Les deux
   plages se CHEVAUCHENT (U+0152-0153, soit oe/OE) et quand deux faces
   correspondent le navigateur retient LA DERNIERE DECLAREE. Avec latin en
   second, un seul « oe » — coeur, soeur, oeil — suffit a faire telecharger les
   10 Ko de latin-ext sur presque toutes les pages francaises. Ne pas reordonner.
*/

/* ---------- Fraunces — titres ----------
   Instance figee : opsz 36, wght 600, SOFT 40, WONK 0.
   L'axe optique est cuit dans le fichier (36 = bon compromis pour des titres
   de 19 a 34 px) : inutile — et sans effet — d'ecrire font-variation-settings.
   La plage 400-700 declaree ci-dessous evite le faux-gras : quel que soit le
   poids demande par le theme, c'est le vrai dessin 600 qui sert.            */
@font-face {
  font-family: 'Fraunces';
  src: url('{{ "gf-fraunces-latin-ext.woff2" | asset_url }}') format('woff2');
  font-weight: 400 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
                 U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF,
                 U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
  font-family: 'Fraunces';
  src: url('{{ "gf-fraunces-latin.woff2" | asset_url }}') format('woff2');
  font-weight: 400 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
                 U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
                 U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

/* ---------- Figtree — corps, interface, boutons ----------
   Vraie variable (400 a 700) : un seul fichier couvre regulier, semi-gras et
   gras, romain comme italique. L'italique est un vrai dessin, pas une oblique
   synthetisee — ce qui sert les legendes de figures.                        */
@font-face {
  font-family: 'Figtree';
  src: url('{{ "gf-figtree-latin-ext.woff2" | asset_url }}') format('woff2');
  font-weight: 400 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF,
                 U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF,
                 U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
  font-family: 'Figtree';
  src: url('{{ "gf-figtree-latin.woff2" | asset_url }}') format('woff2');
  font-weight: 400 700;
  font-style: normal;
  font-display: swap;
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA,
                 U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
                 U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
