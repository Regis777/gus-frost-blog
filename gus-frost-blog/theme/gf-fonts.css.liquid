                 U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
                 U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

/* ---------- Bascule des variables Dawn ----------
   Dawn declare ces variables dans un <style> de layout/theme.liquid a partir
   des reglages type_header_font / type_body_font. On les redefinit ici, a
   specificite egale mais PLUS LOIN dans la cascade : tout le theme suit, y
   compris gf-article.css qui consomme deja var(--font-body-family).
   Les @font-face Montserrat/Lora emis par le theme restent en place mais plus
   aucune regle ne les appelle : les fichiers ne sont donc pas telecharges.  */
:root {
  --font-heading-family: 'Fraunces', Georgia, 'Times New Roman', serif;
  --font-heading-style: normal;
  --font-heading-weight: 600;

  --font-body-family: 'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI',
                      Roboto, Helvetica, Arial, sans-serif;
  --font-body-style: normal;
  --font-body-weight: 400;
  --font-body-weight-bold: 700;
}

/* ---------- Raccords sur les articles ----------
   gf-article.css code en dur une pile systeme a deux endroits (en-tetes de
   tableau et etiquette de l'encadre conseil) : c'etait un pis-aller quand le
   corps etait en Lora. Figtree fait maintenant le travail. Specificite
   volontairement superieure pour ne pas dependre de l'ordre de chargement
   des deux feuilles.                                                        */
.gf-article table th,
.gf-article .gf-conseil strong {
  font-family: var(--font-body-family);
}

/* Fraunces est un peu plus large de chasse que Montserrat en bas de l'echelle :
   un leger resserrement rend les gros titres plus fermes. Sans effet sous 24 px. */
.gf-article h1 { letter-spacing: -0.012em; }
.gf-article h2 { letter-spacing: -0.008em; }
