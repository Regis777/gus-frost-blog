{%- comment -%}
  Section "Le Club Gus et Frost" - page publique d'adhesion
  --------------------------------------------------------------------------
  Programme de fidelite maison, gratuit, sans application : on n'installe ni
  Smile.io ni equivalent. L'adhesion, c'est simplement un compte client
  Shopify, plus l'inscription a la liste Klaviyo du Club.

  Deux avantages promis : les guides reserves et l'acces anticipe. Ils sont
  servis par la page /pages/espace-membre (section gf-espace-membre), qui ne
  s'ouvre qu'aux visiteurs connectes.

  Pre-requis dans le theme :
    - assets/gf-club.css
    - assets/gf-club.js

  Le formulaire ne cree PAS le compte : il inscrit le profil dans Klaviyo,
  puis renvoie vers la creation de compte Shopify (mot de passe en comptes
  classiques, code par e-mail en nouveaux comptes clients). C'est le seul
  montage possible sans application, et il a l'avantage de recuperer l'e-mail
  meme quand la personne abandonne a l'etape du compte.

  Klaviyo : endpoints CLIENT, cle PUBLIQUE uniquement. Cle ou liste vide =
  aucun appel reseau, le formulaire envoie directement vers le compte.

  Les textes destines aux visiteurs portent des espaces insecables (U+00A0)
  avant : ; ! ? et apres les guillemets ouvrants. Ne pas les remplacer par des
  espaces ordinaires en editant le fichier.
{%- endcomment -%}

{{ 'gf-club.css' | asset_url | stylesheet_tag }}

{%- assign compte_url = section.settings.compte_url | default: routes.account_register_url -%}
{%- assign espace_url = section.settings.espace_url | default: '/pages/espace-membre' -%}
{%- assign avantages = section.blocks | where: 'type', 'avantage' -%}
{%- assign etapes = section.blocks | where: 'type', 'etape' -%}

<div class="gfc" data-gfc {{ section.shopify_attributes }}>

  {%- comment -%} ---------- Deja connecte : on ne redemande rien ---------- {%- endcomment -%}
  {%- if customer -%}
    <div class="gfc-bandeau">
      <p>
        {%- if customer.first_name != blank -%}
          {{ section.settings.membre_titre | replace: '[prenom]', customer.first_name | escape }}
        {%- else -%}
          {{ section.settings.membre_titre | replace: '[prenom]', '' | strip | escape }}
        {%- endif -%}
      </p>
      <a class="gfc-btn" href="{{ espace_url }}">{{ section.settings.membre_bouton | escape }}</a>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- En-tete ---------- {%- endcomment -%}
  <div class="gfc-hero">
    <h1>{{ section.settings.hero_heading | escape }}</h1>
    {%- if section.settings.hero_text != blank -%}
      <p class="gfc-hero-sous">{{ section.settings.hero_text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.preuves != blank -%}
      <p class="gfc-preuves">
        {%- assign items = section.settings.preuves | split: '|' -%}
        {%- for i in items -%}<span>{{ i | strip | escape }}</span>{%- endfor -%}
      </p>
    {%- endif -%}
    {%- unless customer -%}
      <a class="gfc-btn" href="#gfc-adhesion">{{ section.settings.cta_label | escape }}</a>
      {%- if section.settings.hero_reassurance != blank -%}
        <p class="gfc-rassure">{{ section.settings.hero_reassurance | escape }}</p>
      {%- endif -%}
      <p class="gfc-rassure" data-gfc-rappel hidden>
        Vous vous êtes déjà inscrit ? <a href="{{ routes.account_login_url }}">Connectez-vous</a> pour ouvrir votre espace.
      </p>
    {%- endunless -%}
    {%- if section.settings.hero_intro != blank -%}
      <div class="gfc-hero-texte">{{ section.settings.hero_intro }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- Les avantages ---------- {%- endcomment -%}
  {%- if avantages.size > 0 -%}
    <div class="gfc-rubrique">
      <h2>{{ section.settings.avantages_heading | escape }}</h2>
      {%- if section.settings.avantages_chapo != blank -%}
        <p class="gfc-chapo">{{ section.settings.avantages_chapo | escape }}</p>
      {%- endif -%}
      <div class="gfc-avantages">
        {%- for b in avantages -%}
          <div class="gfc-avantage" {{ b.shopify_attributes }}>
            {%- if b.settings.icone != blank -%}
              <span class="gfc-avantage-icone" aria-hidden="true">{{ b.settings.icone }}</span>
            {%- endif -%}
            <h3>{{ b.settings.titre | escape }}</h3>
            <p>{{ b.settings.texte | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- Comment ca marche ---------- {%- endcomment -%}
  {%- if etapes.size > 0 -%}
    <div class="gfc-rubrique">
      <h2>{{ section.settings.etapes_heading | escape }}</h2>
      <ol class="gfc-etapes">
        {%- for b in etapes -%}
          <li class="gfc-etape" {{ b.shopify_attributes }}>
            <h3>{{ b.settings.titre | escape }}</h3>
            <p>{{ b.settings.texte | escape }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- Formulaire d'adhesion ---------- {%- endcomment -%}
  {%- unless customer -%}
    <div class="gfc-form-carte" id="gfc-adhesion">

      <div data-gfc-panneau-form>
        <h2>{{ section.settings.form_heading | escape }}</h2>
        {%- if section.settings.form_chapo != blank -%}
          <p class="gfc-chapo">{{ section.settings.form_chapo | escape }}</p>
        {%- endif -%}

        <form class="gfc-form" data-gfc-form novalidate>
          <div class="gfc-champs">
            <label class="gfc-champ">
              <span>{{ section.settings.label_prenom | escape }}</span>
              <input type="text" name="prenom" autocomplete="given-name">
            </label>
            <label class="gfc-champ">
              <span>{{ section.settings.label_email | escape }}</span>
              <input type="email" name="email" autocomplete="email" required>
            </label>
            {%- if section.settings.afficher_animal -%}
              <label class="gfc-champ">
                <span>{{ section.settings.label_animal | escape }}</span>
                <input type="text" name="animal">
              </label>
            {%- endif -%}
          </div>

          <label class="gfc-consent">
            <input type="checkbox" name="consent" required>
            <span>
              {{ section.settings.consent_texte | escape }}
              {%- if section.settings.politique_url != blank -%}
                <a href="{{ section.settings.politique_url }}" target="_blank" rel="noopener">{{ section.settings.politique_label | escape }}</a>.
              {%- endif -%}
            </span>
          </label>

          <p class="gfc-erreur" data-gfc-erreur hidden></p>

          <div class="gfc-form-actions">
            <button type="submit" class="gfc-btn" data-gfc-envoyer>{{ section.settings.form_bouton | escape }}</button>
          </div>

          {%- if section.settings.form_note != blank -%}
            <p class="gfc-note">{{ section.settings.form_note | escape }}</p>
          {%- endif -%}
        </form>
      </div>

      <div class="gfc-succes" data-gfc-panneau-succes hidden>
        <h2>{{ section.settings.succes_titre | escape }}</h2>
        <p>{{ section.settings.succes_texte | escape }}</p>
        <a class="gfc-btn" href="{{ compte_url }}" data-gfc-compte>{{ section.settings.succes_bouton | escape }}</a>
        {%- if section.settings.succes_note != blank -%}
          <p class="gfc-note">{{ section.settings.succes_note | escape }}</p>
        {%- endif -%}
      </div>

    </div>
  {%- endunless -%}

  {%- comment -%} ---------- Configuration passee au moteur JS ---------- {%- endcomment -%}
  <script type="application/json" data-gfc-config>
  {
    "cle": {{ section.settings.klaviyo_cle | default: '' | json }},
    "liste": {{ section.settings.klaviyo_liste | default: '' | json }},
    "source": {{ section.settings.source | default: 'club' | json }},
    "metric": {{ section.settings.metric | default: 'Adhésion Club' | json }},
    "compte_url": {{ compte_url | json }}
  }
  </script>
</div>

<script src="{{ 'gf-club.js' | asset_url }}" defer></script>

