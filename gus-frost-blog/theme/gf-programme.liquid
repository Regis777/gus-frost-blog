<script>
(function () {
  var racine = document.getElementById('gf-prog');
  if (!racine) return;

  /* Barre fixe : visible une fois l'ouverture dépassée, masquée quand l'inscription est à l'écran */
  var barre = racine.querySelector('[data-gfp-barre]');
  var haut = racine.querySelector('[data-gfp-ouverture]');
  var fin = racine.querySelector('[data-gfp-fin]');
  if (barre && haut && fin && 'IntersectionObserver' in window) {
    var hautVu = true, finVue = false;
    var maj = function () {
      var montrer = !hautVu && !finVue;
      barre.classList.toggle('est-visible', montrer);
      barre.setAttribute('aria-hidden', montrer ? 'false' : 'true');
      var lien = barre.querySelector('a,button');
      if (lien) lien.tabIndex = montrer ? 0 : -1;
    };
    new IntersectionObserver(function (e) { hautVu = e[0].isIntersecting; maj(); }).observe(haut);
    new IntersectionObserver(function (e) { finVue = e[0].isIntersecting; maj(); }).observe(fin);
  }

  /* Inscription Klaviyo (endpoints client : clé publique uniquement, liste en double opt-in) */
  var cle = racine.getAttribute('data-cle'), liste = racine.getAttribute('data-liste');
  var formulaires = racine.querySelectorAll('[data-gfp-form]');
  Array.prototype.forEach.call(formulaires, function (f) {
    var msg = f.nextElementSibling;
    f.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var champ = f.querySelector('input[type=email]');
      var email = (champ.value || '').trim();
      var dire = function (t) { if (msg) { msg.textContent = t; msg.hidden = false; } };
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { dire('Cette adresse ne semble pas valide.'); champ.focus(); return; }
      if (!cle || !liste) { dire('L’inscription n’est pas encore ouverte. Revenez bientôt.'); return; }
      var bouton = f.querySelector('button'); bouton.disabled = true;
      fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(cle), {
        method: 'POST',
        headers: { 'content-type': 'application/json', revision: '2024-10-15' },
        body: JSON.stringify({ data: { type: 'subscription', attributes: {
          custom_source: 'Page du Programme',
          profile: { data: { type: 'profile', attributes: { email: email, properties: { source_lead: 'page_programme' } } } } },
          relationships: { list: { data: { type: 'list', id: liste } } } } })
      }).then(function (r) {
        if (!(r.ok || r.status === 202)) throw new Error('Klaviyo ' + r.status);
        f.hidden = true;
        dire('C’est noté. Un e-mail vous demande de confirmer votre adresse : le guide arrive juste après. Pensez à regarder dans les indésirables.');
      }).catch(function (e) {
        console.warn('[programme] inscription impossible', e);
        bouton.disabled = false;
        dire('L’inscription n’a pas pu aboutir. Réessayez dans un instant, ou écrivez-nous à contact@gusetfrost.fr.');
      });
    });
  });
})();
</script>

