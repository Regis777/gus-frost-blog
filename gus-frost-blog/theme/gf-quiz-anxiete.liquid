{%- comment -%}
  Section « Quiz diagnostic — anxiété de séparation »
  --------------------------------------------------------------------------
  Diagnostic scoré maison, sans app ni abonnement. Équivalent (et un cran mieux)
  des outils type ScoreApp / Involve.me / RevenueHunt.

  Contenu = le « Kit de montage » Gus et Frost (12 questions, barème 0/1/2,
  3 profils, mur e-mail). Repris au mot près, éditable ici.

  Pré-requis dans le thème :
    - assets/gf-quiz-anxiete.css
    - assets/gf-quiz-anxiete.js

  Réglages : questions = blocs « Question » ; 3 bandes vert/orange/rouge ;
  mur e-mail + branchement Klaviyo (clé PUBLIQUE + id de liste).

  Signal d'alerte : mettre le champ « alerte » d'une question sur le n° de la
  réponse qui doit forcer la zone rouge. Ici Q10 (« même 5 minutes… ») et Q12
  (« il s'est déjà blessé… ») = réponse 3 → bascule rouge, quel que soit le score.

  Klaviyo : mêmes endpoints CLIENT que « Le Carnet ». Clé vide = le quiz montre
  le résultat sans capturer l'e-mail. Propriétés poussées : quiz_profil,
  quiz_score, signal_alerte, source_lead, prenom.
{%- endcomment -%}

{{ 'gf-quiz-anxiete.css' | asset_url | stylesheet_tag }}

{%- assign qblocks = section.blocks | where: 'type', 'question' -%}

<div class="gfq" data-gfq {{ section.shopify_attributes }}>

  {%- comment -%} ---------- Écran d'accueil ---------- {%- endcomment -%}
  <div data-gfq-intro>
    <div class="gfq-intro">
      <h1>{{ section.settings.hero_heading | escape }}</h1>
      {%- if section.settings.hero_text != blank -%}
        <p class="gfq-intro-sous">{{ section.settings.hero_text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.hero_intro != blank -%}
        <div class="gfq-intro-texte">{{ section.settings.hero_intro }}</div>
      {%- endif -%}
      {%- if section.settings.meta != blank -%}
        <p class="gfq-meta">
          {%- assign items = section.settings.meta | split: '|' -%}
          {%- for i in items -%}<span>{{ i | strip | escape }}</span>{%- endfor -%}
        </p>
      {%- endif -%}
      <button type="button" class="gfq-btn" data-gfq-start>{{ section.settings.start_label | escape }}</button>
      {%- if section.settings.hero_reassurance != blank -%}
        <p class="gfq-intro-rassure">{{ section.settings.hero_reassurance | escape }}</p>
      {%- endif -%}
      <p class="gfq-rappel" data-gfq-rappel hidden>
        Vous avez déjà fait ce test. <a href="#" data-gfq-revoir>Revoir mon résultat</a>.
      </p>
    </div>
  </div>

  {%- comment -%} ---------- Progression + scène (remplie par le JS) ---------- {%- endcomment -%}
  <div class="gfq-progress" data-gfq-progress hidden>
    <p class="gfq-compteur" data-gfq-compteur></p>
    <div class="gfq-jauge-piste"><div class="gfq-jauge" data-gfq-jauge></div></div>
  </div>
  <div data-gfq-scene></div>

  {%- comment -%} ---------- Configuration passée au moteur JS ---------- {%- endcomment -%}
  <script type="application/json" data-gfq-config>
  {
    "cle": {{ section.settings.klaviyo_cle | default: '' | json }},
    "liste": {{ section.settings.klaviyo_liste | default: '' | json }},
    "source": {{ section.settings.source | default: 'quiz_anxiete_separation' | json }},
    "metric": {{ section.settings.metric | default: 'Quiz anxiété terminé' | json }},
    "seuil_vert": {{ section.settings.seuil_vert | default: 6 }},
    "seuil_orange": {{ section.settings.seuil_orange | default: 14 }},
    "alertes_pour_rouge": {{ section.settings.alertes_pour_rouge | default: 1 }},
    "questions": [
      {%- for b in qblocks -%}
        {
          "enonce": {{ b.settings.enonce | json }},
          "alerte": {{ b.settings.alerte | default: 0 }},
          "reponses": [
            {%- assign n = 0 -%}
            {%- for i in (1..4) -%}
              {%- assign tkey = 'r' | append: i -%}
              {%- assign pkey = 'p' | append: i -%}
              {%- assign t = b.settings[tkey] -%}
              {%- if t != blank -%}
                {%- if n > 0 -%},{%- endif -%}
                { "t": {{ t | json }}, "p": {{ b.settings[pkey] | default: 0 }} }
                {%- assign n = n | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "mur": {
      "titre": {{ section.settings.mur_titre | json }},
      "texte": {{ section.settings.mur_texte | json }},
      "prenom_placeholder": {{ section.settings.mur_prenom | json }},
      "placeholder": {{ section.settings.mur_placeholder | json }},
      "consent": {{ section.settings.mur_consent | json }},
      "bouton": {{ section.settings.mur_bouton | json }},
      "note": {{ section.settings.mur_note | json }}
    },
    "bands": {
      "vert": {
        "badge": {{ section.settings.vert_badge | json }},
        "titre": {{ section.settings.vert_titre | json }},
        "html": {{ section.settings.vert_html | json }},
        "promo": {{ section.settings.vert_promo | json }},
        "promo_label": {{ section.settings.vert_promo_label | json }},
        "cta_label": {{ section.settings.vert_cta_label | json }},
        "cta_url": {{ section.settings.vert_cta_url | json }}
      },
      "orange": {
        "badge": {{ section.settings.orange_badge | json }},
        "titre": {{ section.settings.orange_titre | json }},
        "html": {{ section.settings.orange_html | json }},
        "promo": {{ section.settings.orange_promo | json }},
        "promo_label": {{ section.settings.orange_promo_label | json }},
        "cta_label": {{ section.settings.orange_cta_label | json }},
        "cta_url": {{ section.settings.orange_cta_url | json }}
      },
      "rouge": {
        "badge": {{ section.settings.rouge_badge | json }},
        "titre": {{ section.settings.rouge_titre | json }},
        "html": {{ section.settings.rouge_html | json }},
        "promo": {{ section.settings.rouge_promo | json }},
        "promo_label": {{ section.settings.rouge_promo_label | json }},
        "cta_label": {{ section.settings.rouge_cta_label | json }},
        "cta_url": {{ section.settings.rouge_cta_url | json }}
      }
    }
  }
  </script>

</div>

<script src="{{ 'gf-quiz-anxiete.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Quiz — anxiété séparation",
  "tag": "section",
  "class": "gf-quiz-anxiete-section",
  "settings": [
    {
      "type": "header",
      "content": "Écran d'accueil"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Titre",
      "default": "Mon chien a-t-il une anxiété de séparation ?"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Sous-titre",
      "default": "Le test d'auto-évaluation pour savoir où en est vraiment votre chien. 12 questions, 2 minutes."
    },
    {
      "type": "richtext",
      "id": "hero_intro",
      "label": "Texte d'introduction",
      "default": "<p>Des dégâts, des aboiements signalés par le voisin, une flaque à votre retour. Devant ces signes, on pense souvent « il se venge » ou « il s'ennuie ». Or tous les chiens qui font des bêtises ne sont pas anxieux, et un chien réellement en détresse ne se travaille pas comme un chien qui s'ennuie.</p><p>Avant de chercher une solution, il faut savoir à quoi vous avez affaire. Ces 12 questions sont là pour ça. Répondez en pensant à ce qui se passe d'habitude, pas à un jour exceptionnel.</p><p>Ce test ne pose aucun diagnostic : il vous aide à y voir clair, et à savoir s'il faut consulter.</p>"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Réassurances en pastilles (séparées par |, facultatif)"
    },
    {
      "type": "text",
      "id": "start_label",
      "label": "Bouton de démarrage",
      "default": "Commencer le test →"
    },
    {
      "type": "text",
      "id": "hero_reassurance",
      "label": "Réassurance sous le bouton",
