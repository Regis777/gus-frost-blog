{%- comment -%}
  Section « Le Carnet, présentation » : la page qui vend l'outil.
  L'app elle-même vit sur une autre page (section gf-carnet, sans encart commercial).
  Pré-requis : assets/gf-carnet-landing.css déposé dans le thème.
{%- endcomment -%}

{{ 'gf-carnet-landing.css' | asset_url | stylesheet_tag }}
{%- comment -%} Fond de page beige (charte du 14/11/2026), pas de blanc pur. {%- endcomment -%}
<style>#shopify-section-{{ section.id }}{ background: #efe7da; }</style>

{%- assign url_app = section.settings.app_url | default: '/pages/mon-carnet' -%}

{%- comment -%}
  « Vous avez déjà un carnet ? » : même adresse que le bouton principal (les données vivent
  dans le navigateur, l'app rouvre le carnet existant), mais un libellé pour qui revient.
{%- endcomment -%}
{%- capture bloc_deja -%}
  {%- if section.settings.deja_label != blank -%}
    <p class="gfl-deja">
      {%- if section.settings.deja_question != blank -%}<span>{{ section.settings.deja_question | escape }}</span>{%- endif -%}
      <a class="gfl-btn-sec" href="{{ url_app }}">{{ section.settings.deja_label | escape }}</a>
    </p>
  {%- endif -%}
{%- endcapture -%}

<div class="gfl">

  <header class="gfl-hero">
    <h1>{{ section.settings.hero_heading | escape }}</h1>
    {%- if section.settings.hero_text != blank -%}
      <p class="gfl-hero-sous">{{ section.settings.hero_text | escape }}</p>
    {%- endif -%}
    <a class="gfl-btn" href="{{ url_app }}">{{ section.settings.cta_label | escape }}</a>
    {{- bloc_deja -}}
    {%- if section.settings.preuves != blank -%}
      <p class="gfl-preuves">
        {%- assign items = section.settings.preuves | split: '|' -%}
        {%- for i in items -%}<span>{{ i | strip | escape }}</span>{%- endfor -%}
      </p>
    {%- endif -%}
  </header>

  {%- assign fonctions = section.blocks | where: 'type', 'fonction' -%}
  {%- if fonctions.size > 0 -%}
    <section class="gfl-sec">
      <div class="gfl-sec-tete">
        {%- if section.settings.fonctions_kick != blank -%}<span class="gfl-kick">{{ section.settings.fonctions_kick | escape }}</span>{%- endif -%}
        <h2 class="gfl-sec-titre">{{ section.settings.fonctions_heading | escape }}</h2>
        {%- if section.settings.fonctions_chapo != blank -%}
          <p class="gfl-sec-chapo">{{ section.settings.fonctions_chapo | escape }}</p>
        {%- endif -%}
      </div>
      <div class="gfl-grille">
        {%- for b in fonctions -%}
          <div class="gfl-carte" {{ b.shopify_attributes }}>
            <h3>{{ b.settings.titre | escape }}</h3>
            <p>{{ b.settings.texte | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  <section class="gfl-final">
    <h2>{{ section.settings.final_heading | escape }}</h2>
    {%- if section.settings.final_text != blank -%}
      <p>{{ section.settings.final_text | escape }}</p>
    {%- endif -%}
    <a class="gfl-btn" href="{{ url_app }}">{{ section.settings.cta_label | escape }}</a>
    {{- bloc_deja -}}
  </section>

  {%- comment -%} « Le principe » : bandeau volontairement discret, après les fonctions. {%- endcomment -%}
  {%- assign atouts = section.blocks | where: 'type', 'atout' -%}
  {%- if atouts.size > 0 -%}
    <section class="gfl-principe">
      {%- if section.settings.atouts_heading != blank -%}
        <h2 class="gfl-principe-titre">{{ section.settings.atouts_heading | escape }}</h2>
      {%- endif -%}
      <ul class="gfl-principe-liste">
        {%- for b in atouts -%}
          <li {{ b.shopify_attributes }}><strong>{{ b.settings.titre | escape }}</strong>
            {%- if b.settings.texte != blank %} {{ b.settings.texte | escape }}{% endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}

  {%- comment -%}
    Confidentialité : court paragraphe discret en bas de page (demande de Régis, 14/11/2026).
    La phrase « rappels par e-mail » doit rester alignée sur proprietesKlaviyo() (gf-carnet.js) :
    les rappels sont actifs, sans elle la page promettrait que rien ne sort de l'appareil.
  {%- endcomment -%}
  {%- if section.settings.privacy_heading != blank -%}
    <section class="gfl-privacy">
      <h2 class="gfl-privacy-titre">{{ section.settings.privacy_heading | escape }}</h2>
      <p>
        {%- if section.settings.privacy_text != blank -%}{{ section.settings.privacy_text | escape }}{%- endif -%}
        {%- if section.settings.privacy_mail != blank %} {{ section.settings.privacy_mail | escape }}{%- endif -%}
        {%- if section.settings.privacy_note != blank %} {{ section.settings.privacy_note | escape }}{%- endif -%}
      </p>
    </section>
  {%- endif -%}

</div>

<script>
  // Compatibilite : une fiche partagee pointant vers l'ancienne adresse de l'app
  // arrive ici. On la renvoie vers l'app en conservant le lien de partage.
  (function () {
    var m = /[#&]fiche=/.exec(window.location.hash);
    if (m) { window.location.replace({{ url_app | json }} + window.location.hash); }
  })();
</script>

