{% comment %}
  ============================================================
  Section : Produit, achat guide (Gus et Frost)
  Page produit longue, sans application. Lit l'objet product.
  ------------------------------------------------------------
  - Option 1 du produit = le palier (ex. « Nombre de tapis » 1/2/3).
  - Option 2 (facultative) = la couleur, rendue en pastilles.
  - Le nombre d'articles est porte par la VARIANTE, quantite panier = 1.
  - Avis : lus dans product.metafields.custom.avis. Rien ne s'affiche
    (ni note, ni bloc) tant qu'aucun avis reel n'est relie au produit.
  - Aucun JSON-LD ici : il vient de snippets/gf-product-schema.liquid.
  - Tailles en px : Dawn regle 1rem = 10px.
  ============================================================
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign p = product
  assign cur = p.selected_or_first_available_variant
  assign opt_qty = p.options_with_values[0]
  assign opt_color = p.options_with_values[1]
  assign has_tiers = false
  if opt_qty and p.has_only_default_variant == false
    assign has_tiers = true
  endif
  assign rid = 'gfpg-' | append: section.id
  assign fid = 'gfpg-form-' | append: section.id

  assign first_v = p.variants.first
  assign base_n = first_v.option1 | plus: 0
  if base_n < 1
    assign base_n = 1
  endif
  assign base_unit = first_v.price | divided_by: base_n

  assign avis_list = p.metafields.custom.avis.value
  assign avis_total = 0
  assign avis_count = 0
  for a in avis_list
    assign n = a.note.value | plus: 0
    assign avis_total = avis_total | plus: n
    assign avis_count = avis_count | plus: 1
  endfor
  assign avis_avg = 0
  if avis_count > 0
    assign avis_avg = avis_total | times: 1.0 | divided_by: avis_count | round: 1
  endif

  assign moments = section.blocks | where: 'type', 'moment'
  assign onglets = section.blocks | where: 'type', 'onglet'
  assign profils = section.blocks | where: 'type', 'profil'
  assign jalons = section.blocks | where: 'type', 'jalon'
  assign gestes = section.blocks | where: 'type', 'geste'
  assign compares = section.blocks | where: 'type', 'compare'
  assign faqs = section.blocks | where: 'type', 'faq'
-%}

{%- style -%}
