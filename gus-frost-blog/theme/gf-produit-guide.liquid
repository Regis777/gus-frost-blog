  #{{ rid }} h1, #{{ rid }} h2, #{{ rid }} h3{ font-family: var(--font-heading-family); font-weight: 600; color: var(--ink); margin: 0; letter-spacing: 0; }
  #{{ rid }} h2{ font-size: 30px; line-height: 1.15; }
