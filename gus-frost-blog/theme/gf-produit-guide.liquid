    #{{ rid }} .mbar button{ flex: 1 1 0; min-width: 0; min-height: 50px; padding: 6px 3px; font-size: 12.5px; border-radius: 10px 10px 0 0; }
    #{{ rid }} .mbar button.on{ min-height: 56px; }
    #{{ rid }} .mom{ border-top-right-radius: 0; }
    #{{ rid }} .mtx{ padding: 14px; }
    #{{ rid }} .mtx h3{ font-size: 20px; margin-bottom: 6px; }
    #{{ rid }} .mtx h4{ margin: 10px 0 6px; }
    #{{ rid }} .gp-path{ gap: 8px; }
    #{{ rid }} .gp-jal{ padding: 12px 14px; }
