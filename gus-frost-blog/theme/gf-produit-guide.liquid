  #{{ rid }} .kick{ font-size: 12px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: var(--ac); margin-bottom: 8px; }
  #{{ rid }} .head{ margin-bottom: 26px; }
  #{{ rid }} .gp-card{ background: var(--card); border: 1px solid var(--line); border-radius: 16px; }
  #{{ rid }} svg.i{ width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 auto; }
  #{{ rid }} button{ font-family: inherit; }

