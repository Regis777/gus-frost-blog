  "presets": [
    {
      "name": "Produit, achat guidé",
      "blocks": [
        { "type": "profil", "settings": { "label": "Un chien, un moment difficile", "tier": "1", "hint": "Un tapis suffit pour tester sur le moment qui pose problème." } },
        { "type": "profil", "settings": { "label": "Un chien, plusieurs moments", "tier": "2", "hint": "Deux tapis : un au congélateur, prêt à sortir, pendant que l’autre sèche." } },
        { "type": "profil", "settings": { "label": "Deux animaux ou plus", "tier": "3", "hint": "Trois tapis : un par animal, donnés à distance, et un d’avance au congélateur." } },

        { "type": "onglet", "settings": { "title": "Bénéfices", "heading": "Pourquoi le léchage apaise", "content": "<p>Lécher de façon répétée ralentit le rythme de votre chien et détourne son attention de ce qui l’inquiète. Les reliefs du tapis allongent ce temps de dix à vingt minutes, davantage si la garniture est congelée.</p><p>Le tapis ne traite pas une anxiété installée à lui seul. Il rend le moment supportable et vous donne une prise pour travailler le reste.</p>" } },
        { "type": "onglet", "settings": { "title": "Utilisation", "heading": "Dans quelles situations le sortir", "content": "<ul><li>Juste avant un départ, pour associer la porte qui se ferme à quelque chose d’agréable.</li><li>Aux premiers bruits d’orage ou de feu d’artifice, avant que la peur monte.</li><li>À l’heure du repas, pour un chien qui avale sa gamelle en trente secondes.</li><li>Collé à la paroi de la baignoire pendant le bain ou la coupe des griffes.</li></ul>" } },
        { "type": "onglet", "settings": { "title": "Entretien", "heading": "Nettoyage et conservation", "content": "<p>Rincez le tapis à l’eau chaude juste après usage, ou passez-le au lave-vaisselle. Ne le laissez pas sécher garni.</p><p>Il supporte le congélateur. Retirez-le si votre chien commence à le mâcher : c’est un tapis à lécher, pas un jouet à mordre.</p>" } },
        { "type": "onglet", "settings": { "title": "Matière", "heading": "De quoi il est fait", "content": "<p>Silicone souple de qualité alimentaire, format 20 × 20 cm, quatre textures de relief et ventouses au dos. Il tient sur une surface lisse et non poreuse : carrelage, verre, baignoire, sol stratifié.</p>" } },

        { "type": "moment", "settings": { "tab": "Orages et pétards", "heading": "Quand le bruit l’inquiète", "text": "Un chien qui a peur du bruit halète, tourne en rond, cherche à se cacher. Le tapis garni, sorti aux premiers grondements, lui donne une occupation qui fait redescendre la tension avant qu’elle déborde.", "points": "Il se pose au lieu de faire les cent pas\nSon attention quitte la fenêtre\nVous avez un geste à faire, plutôt que d’assister à sa peur" } },
        { "type": "moment", "settings": { "tab": "Départs", "heading": "Quand vous fermez la porte", "text": "Les premières minutes après votre départ sont les plus difficiles. Posez le tapis au moment où vous enfilez votre manteau : le signal du départ annonce désormais quelque chose de bon.", "points": "Moins d’agitation pendant vos préparatifs\nLes premières minutes seul sont occupées\nLe départ cesse d’être un événement" } },
        { "type": "moment", "settings": { "tab": "Repas", "heading": "Quand il mange trop vite", "text": "Étalée dans les reliefs, la ration ne s’avale plus d’un coup. Votre chien doit la chercher à la langue, ce qui allonge le repas de plusieurs minutes.", "points": "Un repas qui dure\nMoins d’air avalé avec la nourriture\nUn chien plus calme en sortant de table" } },
        { "type": "moment", "settings": { "tab": "Bain et griffes", "heading": "Quand il faut le manipuler", "text": "Collé à hauteur de museau sur la paroi de la baignoire, le tapis occupe votre chien pendant que vous le douchez, le brossez ou lui coupez les griffes.", "points": "Il reste en place sans être tenu\nLe soin s’associe à une récompense\nVous travaillez à deux mains" } },

        { "type": "jalon", "settings": { "when": "Jour 1", "heading": "La découverte", "points": "Il comprend le principe en quelques secondes\nComptez dix à vingt minutes d’occupation\nCommencez par un moment calme, pas par l’orage" } },
        { "type": "jalon", "settings": { "when": "Semaine 1", "heading": "Le rituel s’installe", "points": "Le tapis sort toujours au même moment\nVotre chien l’attend et se pose plus vite\nVous passez à la version congelée, plus longue" } },
        { "type": "jalon", "settings": { "when": "Après un mois", "heading": "Le moment difficile change de sens", "points": "Le départ ou le bain annonce le tapis\nL’agitation d’avant diminue\nSi rien ne bouge, le guide vous dit quoi ajuster" } },

        { "type": "geste", "settings": { "heading": "Garnissez", "text": "Étalez pâtée, yaourt nature ou purée de potiron dans les reliefs." } },
        { "type": "geste", "settings": { "heading": "Fixez", "text": "Plaquez les ventouses sur une surface lisse : carrelage, vitre, baignoire." } },
        { "type": "geste", "settings": { "heading": "Laissez lécher", "text": "Dix à vingt minutes. Congelez le tapis garni pour doubler la durée." } },

        { "type": "compare", "settings": { "label": "Matière", "us": "Silicone de qualité alimentaire", "them": "Composition souvent non précisée" } },
        { "type": "compare", "settings": { "label": "Tenue", "us": "Ventouses sur tout le dos", "them": "Variable selon les modèles" } },
        { "type": "compare", "settings": { "label": "Reliefs", "us": "Quatre textures pour ralentir le léchage", "them": "Un seul relief, le plus souvent" } },
        { "type": "compare", "settings": { "label": "Accessoires", "us": "Spatule et grattoir inclus dès 2 tapis", "them": "Rarement fournis" } },
        { "type": "compare", "settings": { "label": "Mode d’emploi", "us": "Guide écrit par un comportementaliste", "them": "Aucun" } },
