  @media (max-width: 479px){
    #{{ rid }} .facts{ grid-template-columns: 1fr; gap: 8px; }
    #{{ rid }} .tabbar{ display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); }
    #{{ rid }} .cmp table{ font-size: 13px; }
    #{{ rid }} .cmp th, #{{ rid }} .cmp td{ padding: 11px 8px; }
    #{{ rid }} .cmp thead th{ font-size: 11.5px; letter-spacing: .03em; }
    #{{ rid }} .cmp td:first-child{ width: 25%; }
    #{{ rid }} .prof button{ font-size: 12.5px; }
    #{{ rid }} .cmp th, #{{ rid }} .cmp td{ padding: 11px 9px; font-size: 13.5px; }
    #{{ rid }} .cmp td:first-child{ width: 24%; }
    #{{ rid }} .expert{ align-items: flex-start; }
    #{{ rid }} .expert img{ width: 64px; height: 64px; }
  }
  @media (prefers-reduced-motion: reduce){ #{{ rid }} .bar{ transition: none; } }
  @media (max-width: 359px){
    #{{ rid }} .cmp table{ font-size: 12px; }
    #{{ rid }} .cmp th, #{{ rid }} .cmp td{ padding: 10px 6px; hyphenate-limit-chars: 9 4 4; -webkit-hyphenate-limit-before: 4; -webkit-hyphenate-limit-after: 4; }
    #{{ rid }} .cmp thead th{ font-size: 10.5px; letter-spacing: 0; }
    #{{ rid }} .cmp td:first-child{ width: 27%; }
  }
{%- endstyle -%}

{%- capture ico_check -%}<svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7"/></svg>{%- endcapture -%}
{%- capture ico_shield -%}<svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>{%- endcapture -%}
{%- capture ico_truck -%}<svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>{%- endcapture -%}
{%- capture ico_book -%}<svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h10"/></svg>{%- endcapture -%}
{%- capture ico_paw -%}<svg class="i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="9" r="1.7"/><circle cx="12" cy="6.5" r="1.7"/><circle cx="17" cy="9" r="1.7"/><path d="M12 12c-3 0-5 2.2-5 4.2S9 19 12 19s5-.8 5-2.8-2-4.2-5-4.2z"/></svg>{%- endcapture -%}

<div id="{{ rid }}" class="gfpg">
  <div class="w">

    {%- comment -%} ================= HAUT DE PAGE ================= {%- endcomment -%}
    <div class="hero">
      <div class="gal">
        {%- if p.featured_image -%}
          <img class="gmain" data-main
            src="{{ p.featured_image | image_url: width: 1100 }}"
            srcset="{{ p.featured_image | image_url: width: 550 }} 550w, {{ p.featured_image | image_url: width: 1100 }} 1100w"
            sizes="(max-width: 899px) 100vw, 540px"
            alt="{{ p.featured_image.alt | default: p.title | escape }}" width="1100" height="1100" fetchpriority="high">
        {%- else -%}
          <div class="gmain">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
        {%- if p.images.size > 1 -%}
          <div class="gth">
            {%- for img in p.images limit: 10 -%}
              <button type="button" class="{% if forloop.first %}on{% endif %}" data-thumb="{{ img | image_url: width: 1100 }}" aria-label="Voir la photo {{ forloop.index }}">
                <img src="{{ img | image_url: width: 140 }}" alt="" width="64" height="64" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="buy">
        {%- if s.badge != blank -%}<span class="badge">{{ ico_paw }}{{ s.badge }}</span>{%- endif -%}

        {%- if avis_count > 0 -%}
          <div class="rate">
            <span class="stars" aria-hidden="true"><span style="width:{{ avis_avg | times: 20 }}%"></span></span>
            <span>{{ avis_avg | replace: '.', ',' }}/5 · {{ avis_count }} avis</span>
          </div>
        {%- endif -%}

        <h1>{{ s.title_override | default: p.title }}</h1>
        {%- if s.subtitle != blank -%}<p class="sub">{{ s.subtitle }}</p>{%- endif -%}

        {%- if s.chips != blank -%}
          <ul class="chips">
            {%- assign lines = s.chips | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}{%- assign c = line | strip -%}{%- if c != blank -%}<li>{{ ico_check }}{{ c }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="facts">
          {%- if s.fact1_title != blank -%}<div class="fact">{{ ico_paw }}<div><b>{{ s.fact1_title }}</b><span>{{ s.fact1_text }}</span></div></div>{%- endif -%}
          {%- if s.fact2_title != blank -%}<div class="fact">{{ ico_book }}<div><b>{{ s.fact2_title }}</b><span>{{ s.fact2_text }}</span></div></div>{%- endif -%}
          {%- if s.fact3_title != blank -%}<div class="fact">{{ ico_shield }}<div><b>{{ s.fact3_title }}</b><span>{{ s.fact3_text }}</span></div></div>{%- endif -%}
        </div>

        <form id="{{ fid }}" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" style="margin:0">
          <input type="hidden" name="id" value="{{ cur.id }}" data-varid>
          <input type="hidden" name="quantity" value="1">

          {%- if has_tiers -%}
            <div class="gp-card box">
              <p class="stp">{{ s.step1_kicker }}</p>
              <h3>{{ s.step1_heading }}</h3>
              {%- if profils.size > 0 -%}
                {%- if s.step1_intro != blank -%}<p class="how">{{ s.step1_intro }}</p>{%- endif -%}
                <div class="prof" role="group" aria-label="{{ s.step1_heading | escape }}">
                  {%- for b in profils -%}
                    <button type="button" data-prof="{{ b.settings.tier | escape }}" data-hint="{{ b.settings.hint | escape }}" aria-pressed="false" {{ b.shopify_attributes }}>{{ b.settings.label }}</button>
                  {%- endfor -%}
                </div>
                <p class="hint" data-hint-out aria-live="polite">{{ s.step1_hint }}</p>
              {%- endif -%}

              <div class="tiers" role="radiogroup" aria-label="{{ opt_qty.name | escape }}">
                {%- for val in opt_qty.values -%}
                  {%- liquid
                    assign n = val | plus: 0
                    if n < 1
                      assign n = 1
                    endif
                    assign tv = nil
                    for v in p.variants
                      if v.option1 == val
                        assign tv = v
                        break
                      endif
                    endfor
                    assign unit = tv.price | divided_by: n
                    assign ref = base_unit | times: n
                    assign pct = 0
                    if ref > tv.price
                      assign pct = ref | minus: tv.price | times: 100.0 | divided_by: ref | round
                    endif
                    case forloop.index
                      when 1
                        assign extra = s.tier1_text
                      when 2
                        assign extra = s.tier2_text
                      else
                        assign extra = s.tier3_text
                    endcase
                  -%}
                  <button type="button" class="tier{% if val == s.popular_qty %} on reco-on{% endif %}" role="radio" aria-checked="{% if val == s.popular_qty %}true{% else %}false{% endif %}" data-tier="{{ val | escape }}">
                    <span class="reco">{{ s.popular_label }}</span>
                    <span class="rad"></span>
                    <span class="tb">
                      <span class="tt">{{ val }} {{ s.unit_label }}{% if pct > 0 %}<span class="pct">-{{ pct }} %</span>{% endif %}</span>
                      {%- if extra != blank -%}<span class="td">{{ extra }}</span>{%- endif -%}
                    </span>
                    <span class="tp">
                      <b>{{ tv.price | money }}</b>
                      {%- if n > 1 -%}<small>soit {{ unit | money }} l’unité</small>{%- endif -%}
                      {%- if s.show_compare and tv.compare_at_price > tv.price -%}<s>{{ tv.compare_at_price | money }}</s>{%- endif -%}
                    </span>
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- if has_tiers and opt_color -%}
            <div class="gp-card box">
              <p class="stp">{{ s.step2_kicker }}</p>
              <p class="clab">{{ opt_color.name }} : <span data-color-label>{{ cur.option2 }}</span></p>
              <div class="sws" role="radiogroup" aria-label="{{ opt_color.name | escape }}">
                {%- for val in opt_color.values -%}
                  {%- assign low = val | downcase -%}
                  {%- case low -%}
                    {%- when 'vert' -%}{%- assign hex = '#6f9c53' -%}
                    {%- when 'bleu' -%}{%- assign hex = '#5b86b0' -%}
                    {%- when 'violet' -%}{%- assign hex = '#8f7bb0' -%}
                    {%- when 'beige' -%}{%- assign hex = '#d8c8a8' -%}
                    {%- when 'gris' -%}{%- assign hex = '#9aa0a3' -%}
                    {%- when 'rose' -%}{%- assign hex = '#d99aa5' -%}
                    {%- when 'noir' -%}{%- assign hex = '#2b2b2b' -%}
                    {%- else -%}{%- assign hex = '#cccccc' -%}
                  {%- endcase -%}
                  <button type="button" class="sw{% if val == cur.option2 %} on{% endif %}" role="radio" aria-checked="{% if val == cur.option2 %}true{% else %}false{% endif %}" aria-label="{{ val | escape }}" title="{{ val | escape }}" data-sw="{{ val | escape }}" style="background:{{ hex }}"></button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- if s.included != blank -%}
            <ul class="incl">
              {%- assign lines = s.included | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}{%- assign c = line | strip -%}{%- if c != blank -%}<li>{{ ico_check }}<span>{{ c }}</span></li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}

          <button type="submit" class="cta" data-atc {% unless cur.available %}disabled{% endunless %}>
            <span data-btnlabel>{{ s.cta_label }}</span><span data-btnprice>· {{ cur.price | money }}</span>
          </button>
        </form>
        {%- if s.cta_micro != blank -%}<p class="micro">{{ ico_shield }}<span>{{ s.cta_micro }}</span></p>{%- endif -%}

        {%- if s.expert_quote != blank -%}
          <div class="expert">
            {%- if s.expert_image -%}
              <img src="{{ s.expert_image | image_url: width: 240 }}" alt="{{ s.expert_name | escape }}" width="84" height="84" loading="lazy">
            {%- endif -%}
            <div>
              {%- if s.expert_kicker != blank -%}<span class="ek">{{ s.expert_kicker }}</span>{%- endif -%}
              <b>{{ s.expert_name }}</b>
              <q>{{ s.expert_quote }}</q>
            </div>
          </div>
        {%- endif -%}

        {%- if onglets.size > 0 -%}
          <div class="gp-card tabs" data-tabs>
            <div class="tabbar" role="tablist">
              {%- for b in onglets -%}
                <button type="button" role="tab" class="{% if forloop.first %}on{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab="{{ forloop.index }}">{{ b.settings.title }}</button>
              {%- endfor -%}
            </div>
            {%- for b in onglets -%}
              <div class="pane" role="tabpanel" data-pane="{{ forloop.index }}" {% unless forloop.first %}hidden{% endunless %} {{ b.shopify_attributes }}>
                {%- if b.settings.heading != blank -%}<h4>{{ b.settings.heading }}</h4>{%- endif -%}
                {{ b.settings.content }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ================= BANDE DE REASSURANCE ================= {%- endcomment -%}
    {%- if s.strip != blank -%}
      <div class="sec strip">
        {%- assign lines = s.strip | newline_to_br | split: '<br />' -%}
        {%- for line in lines -%}{%- assign c = line | strip -%}{%- if c != blank -%}<span>{{ ico_check }}{{ c }}</span>{%- endif -%}{%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ================= MOMENTS D'USAGE ================= {%- endcomment -%}
    {%- if moments.size > 0 -%}
      <div class="sec" data-tabs>
        <div class="head">
          {%- if s.moments_kicker != blank -%}<p class="kick">{{ s.moments_kicker }}</p>{%- endif -%}
          <h2>{{ s.moments_heading }}</h2>
          {%- if s.moments_lead != blank -%}<p class="lead">{{ s.moments_lead }}</p>{%- endif -%}
        </div>
        <div class="mbar" role="tablist">
          {%- for b in moments -%}
            <button type="button" role="tab" class="{% if forloop.first %}on{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab="{{ forloop.index }}">{{ b.settings.tab }}</button>
          {%- endfor -%}
        </div>
        {%- for b in moments -%}
          <div class="gp-card mom{% unless b.settings.image %} noimg{% endunless %}" role="tabpanel" data-pane="{{ forloop.index }}" {% unless forloop.first %}hidden{% endunless %} {{ b.shopify_attributes }}>
            <div class="mtx">
              <h3>{{ b.settings.heading }}</h3>
              <p>{{ b.settings.text }}</p>
              {%- if b.settings.points != blank -%}
                <h4>{{ s.moments_points_label }}</h4>
                <ul>
                  {%- assign lines = b.settings.points | newline_to_br | split: '<br />' -%}
                  {%- for line in lines -%}{%- assign c = line | strip -%}{%- if c != blank -%}<li>{{ ico_check }}<span>{{ c }}</span></li>{%- endif -%}{%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
            {%- if b.settings.image -%}
              <img src="{{ b.settings.image | image_url: width: 900 }}" alt="{{ b.settings.image.alt | default: b.settings.heading | escape }}" width="900" height="675" loading="lazy">
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ================= PARCOURS ================= {%- endcomment -%}
    {%- if jalons.size > 0 -%}
      <div class="sec">
        <div class="head">
          {%- if s.path_kicker != blank -%}<p class="kick">{{ s.path_kicker }}</p>{%- endif -%}
          <h2>{{ s.path_heading }}</h2>
          {%- if s.path_lead != blank -%}<p class="lead">{{ s.path_lead }}</p>{%- endif -%}
        </div>
        <div class="gp-path">
          {%- for b in jalons -%}
            <div class="gp-card gp-jal" {{ b.shopify_attributes }}>
              <span class="when">{{ b.settings.when }}</span>
              <h3>{{ b.settings.heading }}</h3>
              <ul>
                {%- assign lines = b.settings.points | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}{%- assign c = line | strip -%}{%- if c != blank -%}<li>{{ ico_check }}<span>{{ c }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ================= MODE D'EMPLOI ================= {%- endcomment -%}
    {%- if gestes.size > 0 -%}
      <div class="sec">
        <div class="head">
          {%- if s.use_kicker != blank -%}<p class="kick">{{ s.use_kicker }}</p>{%- endif -%}
          <h2>{{ s.use_heading }}</h2>
          {%- if s.use_lead != blank -%}<p class="lead">{{ s.use_lead }}</p>{%- endif -%}
        </div>
        <div class="use{% unless s.use_image %} noimg{% endunless %}">
          {%- if s.use_image -%}
            <img src="{{ s.use_image | image_url: width: 1000 }}" alt="{{ s.use_image.alt | default: s.use_heading | escape }}" width="1000" height="750" loading="lazy">
          {%- endif -%}
          <div class="gst">
            {%- for b in gestes -%}
              <div class="gp-card ge" {{ b.shopify_attributes }}>
                <span class="n">{{ forloop.index }}</span>
                <div><b>{{ b.settings.heading }}</b><span>{{ b.settings.text }}</span></div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ================= COMPARATIF ================= {%- endcomment -%}
    {%- if compares.size > 0 -%}
      <div class="sec">
        <div class="head">
          {%- if s.cmp_kicker != blank -%}<p class="kick">{{ s.cmp_kicker }}</p>{%- endif -%}
          <h2>{{ s.cmp_heading }}</h2>
        </div>
        <div class="gp-card cmp">
          <table>
            <thead><tr><th scope="col"><span class="visually-hidden">Critère</span></th><th scope="col" class="us">{{ s.cmp_us }}</th><th scope="col">{{ s.cmp_them }}</th></tr></thead>
            <tbody>
              {%- for b in compares -%}
                <tr {{ b.shopify_attributes }}><td>{{ b.settings.label }}</td><td class="us">{{ b.settings.us }}</td><td class="them">{{ b.settings.them }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ================= GARANTIE ================= {%- endcomment -%}
    {%- if s.guar_heading != blank -%}
      <div class="sec guar">
        <div class="gi">{{ ico_shield }}</div>
        <div><h2>{{ s.guar_heading }}</h2><p>{{ s.guar_text }}</p></div>
      </div>
    {%- endif -%}

    {%- comment -%} ================= AVIS (reels uniquement) ================= {%- endcomment -%}
    {%- if avis_count > 0 -%}
      <div class="sec">
        <div class="head">
          <p class="kick">{{ avis_avg | replace: '.', ',' }}/5 sur {{ avis_count }} avis</p>
          <h2>{{ s.reviews_heading }}</h2>
        </div>
        <div class="revs">
          {%- for a in avis_list limit: 9 -%}
            {%- assign n = a.note.value | plus: 0 -%}
            <div class="gp-card rv">
              <span class="stars" role="img" aria-label="Noté {{ n }} sur 5"><span style="width:{{ n | times: 20 }}%"></span></span>
              {%- if a.titre.value != blank -%}<b>{{ a.titre.value | escape }}</b>{%- endif -%}
              <p>{{ a.contenu.value | escape }}</p>
              <span class="who">{{ a.auteur.value | escape }}{% if a.verifie.value %} · Achat vérifié{% endif %}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ================= FAQ ================= {%- endcomment -%}
    {%- if faqs.size > 0 -%}
      <div class="sec">
        <div class="head">
          {%- if s.faq_kicker != blank -%}<p class="kick">{{ s.faq_kicker }}</p>{%- endif -%}
          <h2>{{ s.faq_heading }}</h2>
        </div>
        <div class="faq">
          {%- for b in faqs -%}
            <details {{ b.shopify_attributes }}>
              <summary>{{ b.settings.question }}</summary>
              <div class="ans">{{ b.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ================= DERNIER APPEL ================= {%- endcomment -%}
    {%- if s.end_heading != blank -%}
      <div class="sec gp-card end">
        <h2>{{ s.end_heading }}</h2>
        {%- if s.end_text != blank -%}<p class="lead">{{ s.end_text }}</p>{%- endif -%}
        <a class="cta" href="#{{ fid }}">{{ s.end_cta }}</a>
      </div>
    {%- endif -%}

  </div>

  <div class="bar" data-bar aria-hidden="true">
    <div class="bi"><span data-bar-label>{{ p.title | truncate: 34 }}</span><b data-bar-price>{{ cur.price | money }}</b></div>
    <button type="submit" form="{{ fid }}" class="cta" data-bar-atc tabindex="-1" {% unless cur.available %}disabled{% endunless %}>{{ s.cta_label }}</button>
  </div>
</div>

<script>
(function(){
  var root = document.getElementById({{ rid | json }});
  if(!root) return;
  var variants = [
    {%- for v in p.variants -%}
      {"id": {{ v.id }}, "o1": {{ v.option1 | json }}, "o2": {{ v.option2 | json }}, "price": {{ v.price | money | json }}, "available": {{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];
  var hasTiers = {{ has_tiers }};
  var unitLabel = {{ s.unit_label | json }};
  var ctaLabel = {{ s.cta_label | json }};
  var soldLabel = {{ s.sold_out_label | json }};
  var sel = { o1: {{ cur.option1 | json }}, o2: {{ cur.option2 | json }} };
  var popular = {{ s.popular_qty | json }};
  if(hasTiers && variants.some(function(v){ return v.o1 === popular; })) sel.o1 = popular;

  function q(a){ return root.querySelector(a); }
  function qa(a){ return Array.prototype.slice.call(root.querySelectorAll(a)); }
  var varInput = q("[data-varid]"), atc = q("[data-atc]"), barAtc = q("[data-bar-atc]");

  function match(){
    for(var i = 0; i < variants.length; i++){
      var v = variants[i];
      if(v.o1 === sel.o1 && (v.o2 === null || v.o2 === sel.o2)) return v;
    }
    return null;
  }
  function render(){
    qa("[data-tier]").forEach(function(t){
      var on = t.getAttribute("data-tier") === sel.o1;
      t.classList.toggle("on", on); t.setAttribute("aria-checked", on ? "true" : "false");
    });
    qa("[data-sw]").forEach(function(w){
      var on = w.getAttribute("data-sw") === sel.o2;
      w.classList.toggle("on", on); w.setAttribute("aria-checked", on ? "true" : "false");
    });
    var cl = q("[data-color-label]"); if(cl) cl.textContent = sel.o2;
    var v = match();
    var ok = !!(v && v.available);
    if(v && varInput) varInput.value = v.id;
    if(atc){
      atc.disabled = !ok;
      q("[data-btnlabel]").textContent = ok ? ctaLabel : soldLabel;
      q("[data-btnprice]").textContent = ok ? "· " + v.price : "";
    }
    if(barAtc) barAtc.disabled = !ok;
    var bp = q("[data-bar-price]"); if(bp && v) bp.textContent = v.price;
    var bl = q("[data-bar-label]");
    if(bl && hasTiers) bl.textContent = sel.o1 + " " + unitLabel + (sel.o2 ? " · " + sel.o2 : "");
  }

  if(hasTiers){
    qa("[data-tier]").forEach(function(t){
      t.addEventListener("click", function(){ sel.o1 = t.getAttribute("data-tier"); render(); });
    });
    qa("[data-sw]").forEach(function(w){
      w.addEventListener("click", function(){ sel.o2 = w.getAttribute("data-sw"); render(); });
    });
    qa("[data-prof]").forEach(function(b){
      b.addEventListener("click", function(){
        var tier = b.getAttribute("data-prof");
        qa("[data-prof]").forEach(function(x){ var on = x === b; x.classList.toggle("on", on); x.setAttribute("aria-pressed", on ? "true" : "false"); });
        qa("[data-tier]").forEach(function(t){ t.classList.toggle("reco-on", t.getAttribute("data-tier") === tier); });
        var out = q("[data-hint-out]"); if(out) out.textContent = b.getAttribute("data-hint") || "";
        if(variants.some(function(v){ return v.o1 === tier; })){ sel.o1 = tier; render(); }
      });
    });
    render();
  }

  qa("[data-thumb]").forEach(function(th){
    th.addEventListener("click", function(){
      var main = q("[data-main]");
      if(main){ main.removeAttribute("srcset"); main.src = th.getAttribute("data-thumb"); }
      qa("[data-thumb]").forEach(function(x){ x.classList.toggle("on", x === th); });
    });
  });

  qa("[data-tabs]").forEach(function(group){
    var tabs = Array.prototype.slice.call(group.querySelectorAll("[data-tab]"));
    var panes = Array.prototype.slice.call(group.querySelectorAll("[data-pane]"));
    tabs.forEach(function(t){
      t.addEventListener("click", function(){
        var k = t.getAttribute("data-tab");
        tabs.forEach(function(x){ var on = x === t; x.classList.toggle("on", on); x.setAttribute("aria-selected", on ? "true" : "false"); });
        panes.forEach(function(pn){ pn.hidden = pn.getAttribute("data-pane") !== k; });
      });
    });
  });

  var bar = q("[data-bar]");
  if(bar && atc && "IntersectionObserver" in window){
    new IntersectionObserver(function(es){
      var e = es[0];
      var show = !e.isIntersecting && e.boundingClientRect.top < 0;
      bar.classList.toggle("show", show);
      bar.setAttribute("aria-hidden", show ? "false" : "true");
      if(barAtc) barAtc.tabIndex = show ? 0 : -1;
    }).observe(atc);
  }
})();
</script>

