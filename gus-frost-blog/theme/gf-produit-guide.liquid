  #{{ rid }} .gth img{ width: 100%; height: 100%; object-fit: cover; display: block; }

  #{{ rid }} .badge{ display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 600; background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; }
  #{{ rid }} .rate{ display: flex; align-items: center; gap: 8px; font-size: 14px; margin-top: 12px; color: var(--mut); }
  #{{ rid }} .stars{ position: relative; display: inline-block; font-size: 17px; line-height: 1; letter-spacing: 2px; color: rgba(49,68,49,.22); }
  #{{ rid }} .stars::before{ content: "★★★★★"; }
  #{{ rid }} .stars span{ position: absolute; left: 0; top: 0; overflow: hidden; white-space: nowrap; color: var(--ac); }
  #{{ rid }} .stars span::before{ content: "★★★★★"; }
  #{{ rid }} h1{ font-size: 36px; line-height: 1.1; margin-top: 14px; }
  #{{ rid }} .sub{ font-size: 17px; color: var(--mut); margin-top: 10px; }
