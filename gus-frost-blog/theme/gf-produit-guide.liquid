    --ac: {{ s.color_accent }}; --on-ac: {{ s.color_on_accent }}; --acf: {{ s.color_accent_fill }}; --cta: {{ s.color_cta }}; --on-cta: {{ s.color_on_cta }}; --sage: {{ s.color_sage }};
    --sage-l: color-mix(in srgb, {{ s.color_sage }} 42%, {{ s.color_card }});
    --ink: {{ s.color_primary }}; --mut: rgba(49,68,49,.82); --line: rgba(49,68,49,.16);
